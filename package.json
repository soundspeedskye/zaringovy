{
  "name": "zaringovy-mobile",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "dependencies": {
    "@expo/vector-icons": "15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "2.110.2",
    "expo": "~57.0.4",
    "expo-application": "~57.0.2",
    "expo-clipboard": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-glass-effect": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-image-manipulator": "~57.0.2",
    "expo-image-picker": "~57.0.2",
    "expo-linking": "~57.0.2",
    "expo-notifications": "~57.0.3",
    "expo-router": "~57.0.4",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-updates": "~57.0.12",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.12",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "~19.2.2",
    "eslint": "9.39.4",
    "eslint-config-expo": "57.0.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "supabase": "2.109.1",
    "typescript": "~6.0.3",
    "vitest": "4.1.10"
  },
  "scripts": {
    "start": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost --scheme zaringovy",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "qa": "npm run typecheck && npm run lint && npm run test:unit",
    "typegen": "expo customize tsconfig.json",
    "clean": "rm -rf .expo ios android dist web-build coverage && npm run typegen",
    "native:reset": "npm run clean && expo prebuild --clean"
  },
  "private": true
}
