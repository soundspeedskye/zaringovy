{
  "expo": {
    "name": "자링고비",
    "slug": "zaringovy",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zaringovy",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.zaringovy.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "지출 또는 프로필 사진을 촬영하기 위해 카메라를 사용합니다.",
        "NSPhotoLibraryUsageDescription": "지출 또는 프로필 사진을 선택하기 위해 사진 보관함을 사용합니다.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.zaringovy.app",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FDF6E3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "지출 또는 프로필 사진을 선택하기 위해 사진 보관함을 사용합니다.",
          "cameraPermission": "지출 또는 프로필 사진을 촬영하기 위해 카메라를 사용합니다.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDF6E3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#2F715D",
          "defaultChannel": "challenge-events"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "64b90866-b73b-4734-8026-024f49470e5b"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/64b90866-b73b-4734-8026-024f49470e5b"
    },
    "owner": "dev.youn.cheon"
  }
}
